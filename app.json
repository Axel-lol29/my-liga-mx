{
  "expo": {
    "name": "My Liga MX",
    "slug": "my-liga-mx",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/branding/my-liga-mx-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F14",
      "imageWidth": 240
    },
    "userInterfaceStyle": "automatic",
    "scheme": "myligamx",
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "defaultChannel": "match-reminders",
          "color": "#2563EB"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0F14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.axellol29.myligamx"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ac7639a3-1dbe-450a-a9e7-682db1e66d91"
      }
    }
  }
}
